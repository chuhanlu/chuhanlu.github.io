---
import BaseLayout from "../layouts/BaseLayout.astro";
const papers = [
    { title: "Parallel Kac’s Walk Generates PRU", authors: "Chuhan Lu, Minglong Qin, Fang Song, Penghui Yao, and Mingnan Zhao.", venue: "ASIACRYPT 2026", href: "https://arxiv.org/abs/2504.14957", label: "arXiv" },
    { title: "Complexity Theory for Quantum Promise Problems", authors: "Nai-Hui Chia, Kai-Min Chung, Tzu-Hsiang Huang, Chuhan Lu, and Jhih-Wei Shih.", venue: "ITCS 2027", href: "https://arxiv.org/abs/2411.03716", label: "arXiv" },
    { title: "Quantum Pseudorandom Scramblers", authors: "Chuhan Lu, Minglong Qin, Fang Song, Penghui Yao, and Mingnan Zhao.", venue: "TCC 2024 · QIP 2024", href: "https://arxiv.org/abs/2309.08941", label: "arXiv" },
];
---
<BaseLayout sideBarActiveItemID="home">
    <div class="academic-home mt-5">
        <header class="mb-7">
            <h1 class="text-4xl sm:text-5xl font-bold mb-3">Chuhan Lu · 陆楚晗</h1>
            <p class="text-lg mb-4">Postdoctoral Researcher · Rice University</p>
            <p class="mb-3">My research focuses on <strong>quantum cryptography</strong>, exploring how the quantum nature of information shapes cryptographic security and the possibilities and limitations of cryptographic tasks.</p>
            <p class="job-market mb-5">I am seeking faculty and postdoctoral positions.</p>
            <nav class="profile-resources" aria-label="Academic resources">
                <div class="resource-group">
                <a class="resource-link resource-cv" href="/cv"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg><span>CV</span></a>
                <span class="cv-pdf-placeholder" role="link" aria-disabled="true" title="PDF coming soon">PDF ↗</span>
                </div>
                <div class="resource-group">
                <a class="resource-link" href="/research"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h7a3 3 0 0 1 3 3v14a4 4 0 0 0-4-2H4zM14 7a3 3 0 0 1 3-3h3v15h-3a4 4 0 0 0-3 2"/></svg><span>Research Statement</span></a>
                <a class="cv-pdf-placeholder rs-pdf-download" href="/rs.pdf" target="_blank" rel="noopener noreferrer" aria-label="Open research statement PDF in a new tab">PDF ↗</a>
                </div>
                <a class="resource-link" href="https://scholar.google.com/citations?user=b8v8K6YAAAAJ" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 10-5 10 5-10 5zM6 11v6c4 3 8 3 12 0v-6M22 9v7"/></svg><span>Google Scholar</span><span class="resource-external" aria-hidden="true">↗</span></a>
            </nav>
        </header>
        <section aria-label="Research and academic background" class="mb-10">
            <p class="mb-4">I study how quantum information changes the foundations of cryptography and the boundaries of what it can achieve. I am particularly interested in how quantum cryptography differs from its classical counterpart in its underlying assumptions, notions of security, and the tasks it can or cannot realize. My work has explored quantum pseudorandomness and complexity-theoretic questions in quantum information. My current interests include zero knowledge for problems with quantum inputs and quantum information-theoretic principles that may inform new cryptographic approaches.</p>
            <p>I currently work with <a href="https://sites.google.com/view/naihuichia" target="_blank" rel="noopener noreferrer">Prof. Nai-Hui Chia</a> at Rice University. I received my Ph.D. in Computer Science from Portland State University, where I was advised by <a href="https://fangsong.info/" target="_blank" rel="noopener noreferrer">Prof. Fang Song</a>.</p>
        </section>
        <section id="publications" aria-labelledby="publications-heading" class="mb-10">
            <h2 id="publications-heading" class="text-2xl font-bold mb-5">Selected Publications</h2>
            <ul class="space-y-6">
                {papers.map(paper => <li>
                    <h3 class="font-semibold">{paper.title} <a class="paper-source" href={paper.href} target="_blank" rel="noopener noreferrer" aria-label={`${paper.label}: ${paper.title}`}>[{paper.label}]</a></h3>
                    <p class="paper-authors">{paper.authors.split('Chuhan Lu').map((part, i) => <>{i > 0 && <strong>Chuhan Lu</strong>}{part}</>)}</p>
                    <p class:list={["paper-venue", {"is-preprint": paper.venue === "Preprint"}]}>{paper.venue}</p>
                </li>)}
            </ul>
            <p class="mt-5 text-sm"><a href="/cv">Full CV, publications, and teaching experience →</a></p>
        </section>
        <section aria-labelledby="background-heading" class="mb-8">
            <h2 id="background-heading" class="text-2xl font-bold mb-4">A Little Background</h2>
            <p>After earning a bachelor’s degree in advertising, I transitioned to computer science in 2017 through Portland State University’s post-baccalaureate program and received my M.S. in 2019. I am especially grateful to Prof. Bryant W. York for his mentorship and encouragement during this transition.</p>
        </section>
    </div>
</BaseLayout>
