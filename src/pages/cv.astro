---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Education</div>
    </div>

    <div class="time-line-container grid gap-4 mb-10">
        <TimeLineElement
            title="Ph.D. in Computer Science"
            <div
            class="text-sm opacity-70"
        >
            2020 -- 2025, Portland State University, GPA 3.94<br />
            2019 -- 2020, Texas A&M University, GPA 4.00
        </TimeLineElement>
        <TimeLineElement
            title="M.S. in Computer Science"
            subtitle="2018 -- 2019, Portland State University, GPA 3.94"
        />
        <TimeLineElement
            title="Post-Baccalaureate in Computer Science"
            subtitle="2017 -- 2018, Portland State University, GPA 4.00"
        />
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Papers</div>
    </div>

    <ul class="list-disc mx-6 mb-10 grid gap-4">
        <!-- Paper 1 -->
        <li class="leading-relaxed">
            <div class="font-semibold">
                Parallel Kac’s Walk Generates PRU
                <a
                    href="https://arxiv.org/abs/2504.14957"
                    target="_blank"
                    class="text-blue-500 underline"
                >
                    [arXiv]
                </a>
                <a
                    href="https://www.notion.so/1b1ead8795d0808daacaffbe6da8f80d?pvs=21"
                    target="_blank"
                    class="text-blue-500 underline"
                >
                    [poster]
                </a>
            </div>

            <div>
                <em class="text-red-600 not-italic font-semibold">Chuhan Lu</em
                >, Minglong Qin, Fang Song, Penghui Yao, and Mingnan Zhao.
            </div>

            <div class="mt-1">
                <a
                    href="https://asiacrypt.iacr.org/2026/"
                    target="_blank"
                    class="text-blue-500 underline font-semibold"
                >
                    ASIACRYPT2026
                </a>
            </div>
        </li>
        <!-- Complexity Theory for Quantum Promise Problems -->
        <li class="leading-relaxed">
            <div class="font-semibold">
                Complexity Theory for Quantum Promise Problems
                <a
                    href="https://arxiv.org/abs/2411.03716"
                    target="_blank"
                    class="text-blue-500 underline"
                >
                    [arXiv]
                </a>
            </div>

            <div>
                Nai-Hui Chia, Kai-Min Chung, Tzu-Hsiang Huang,
                <em class="text-red-600 not-italic font-semibold">Chuhan Lu</em
                >, and Jhih-Wei Shih.
            </div>
        </li>
        <!-- Paper 2 -->
        <li class="leading-relaxed">
            <div class="font-semibold">
                Quantum Pseudorandom Scramblers
                <a
                    href="https://arxiv.org/abs/2309.08941"
                    target="_blank"
                    class="text-blue-500 underline"
                >
                    [arXiv]
                </a>
            </div>

            <div>
                <em class="text-red-600 not-italic font-semibold">Chuhan Lu</em
                >, Minglong Qin, Fang Song, Penghui Yao, and Mingnan Zhao.
            </div>

            <div class="mt-1">
                <a
                    href="https://qip2024.tw/site/page.aspx?pid=901&sid=1522&lang=en"
                    target="_blank"
                    class="text-blue-500 underline font-semibold"
                >
                    QIP2024
                </a>
                &nbsp;
                <a
                    href="https://tcc.iacr.org/2024/"
                    target="_blank"
                    class="text-blue-500 underline font-semibold"
                >
                    TCC2024
                </a>
            </div>
        </li>
        <!-- Paper 3 -->
        <li class="leading-relaxed">
            <div class="font-semibold">
                Notions of Quantum Reductions and Impossibility of
                Statistical-NIZK
            </div>

            <div>
                <em class="text-red-600 not-italic font-semibold">Chuhan Lu</em
                >, Nikhil Pappu.
            </div>

            <div class="mt-1">
                <a
                    href="https://eprint.iacr.org/2024/1847"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-500 underline font-semibold"
                >
                    [ePrint]
                </a>
            </div>
        </li>
    </ul>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Posters & Projects</div>
    </div>

    <ul class="list-disc mx-6 mb-10 grid gap-4">
        <!-- Poster 1 -->
        <li class="leading-relaxed">
            <div class="font-semibold">
                A Quantum Algorithm for the Hidden Subgroup Problem on Z^n
            </div>

            <div>
                <em class="text-red-600 not-italic font-semibold">Chuhan Lu</em>
            </div>

            <div class="mt-1">
                <a
                    href="http://aqis-conf.org/2021/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-500 underline font-semibold"
                >
                    AQIS2021
                </a>
            </div>
        </li>

        <!-- Project items -->
        <li class="leading-relaxed font-semibold">
            A Genetic Algorithm Attack on the SVP Challenge in APL (2019)
        </li>

        <li class="leading-relaxed font-semibold">
            Implementation of Quadratic Sieve in APL (2018)
        </li>

        <li class="leading-relaxed font-semibold">
            A Study of the Nonabelian Hidden Subgroup Problem (2018)
        </li>
    </ul>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Teaching Assistant</div>
    </div>

    <ul class="list-disc mx-6 mb-10 grid gap-4 leading-relaxed">
        <li>CS 350 Algorithms and Complexity (Spring 2025)</li>
        <li>CS 581 Theory of Computation (Fall 2024)</li>
        <li>CS 251 Discrete Structures II (Spring 2024)</li>
        <li>CS 491/591 Intro to Computer Security (Fall 2022)</li>
    </ul>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Awards</div>
    </div>

    <ul class="list-disc mx-6 mb-10 grid gap-4 leading-relaxed">
        <li class="font-semibold">
            Wedge Vision Fellowship, 2020–2021 academic year
        </li>
    </ul>
</BaseLayout>
